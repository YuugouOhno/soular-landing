# 問い合わせフォーム (/api/contact) のメール送信設定。
# 移行前は Cloudflare の secret / vars に入れていたもの。Vercel では
# Project Settings → Environment Variables に同じ値を設定する。
#
# ⚠️ RESEND_API_KEY は Cloudflare の secret からは読み出せない。
#    Resend のダッシュボードで既存キーを確認するか、新規発行すること。

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@soular-inc.com
RESEND_FROM_NAME=soular
