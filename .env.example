# 問い合わせフォーム (/api/contact) のメール送信設定。
# 移行前は Cloudflare の secret / vars に入れていたもの。Vercel では
# Project Settings → Environment Variables に同じ値を設定する。
#
# ⚠️ RESEND_API_KEY は Cloudflare の secret からは読み出せない。
#    Resend のダッシュボードで既存キーを確認するか、新規発行すること。

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@soular-inc.com
RESEND_FROM_NAME=soular

# --- 事前確認フォーム（precontract）-------------------------------------
# 合言葉（営業が顧客に口頭で伝えるもの）。本番未設定だと受付停止（fail-closed）。
PRECONTRACT_ACCESS_PASSWORD=

# 同意データの保存先となる各サービスの API。soular 自身は同意データを保持しない。
# シークレットはアプリごとに別のものを使う（1つ漏れても他へ波及させない）。
PRECONTRACT_HRMS_URL=https://soular-hrms.com
PRECONTRACT_HRMS_SECRET=
PRECONTRACT_AICHAT_URL=https://magokoro-ai.com
PRECONTRACT_AICHAT_SECRET=
PRECONTRACT_RIPICHAN_URL=
PRECONTRACT_RIPICHAN_SECRET=
